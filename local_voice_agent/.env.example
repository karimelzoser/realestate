# PRENEURA 6.3 local Egyptian voice agent
PRENEURA_VOICE_PORT=8765
PRENEURA_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,https://karimelzoser.github.io

# Best Arabic ASR. Accept the Hugging Face model conditions once and run `hf auth login`.
PRENEURA_ASR_BACKEND=cohere
PRENEURA_ASR_MODEL=CohereLabs/cohere-transcribe-arabic-07-2026
# Public lighter emergency fallback used automatically when the primary model cannot load.
PRENEURA_ASR_FALLBACK_MODEL=dev-ahmedhany/whisper-large-v3-turbo-arabic-ft-ct2-int8

# Local OpenAI-compatible agent brain.
PRENEURA_LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
PRENEURA_LLM_BASE_URL=http://127.0.0.1:8000/v1
PRENEURA_LLM_API_KEY=local

# Egyptian TTS / calm female default voice.
PRENEURA_TTS_MODEL=mohammedaly22/VoiceTut-TTS
PRENEURA_TTS_SPEAKER=Omnia
