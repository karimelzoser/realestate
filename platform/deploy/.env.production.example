# Public HTTPS origin terminated by your load balancer / TLS proxy.
PUBLIC_ORIGIN=https://realestate.example.com
HTTP_PORT=8080

# Immutable build provenance. Set both to exact full 40-character Git SHAs.
# PRENEURA_SOURCE_SHA is the certified deployment-bundle/source commit being built.
# PRENEURA_APPLICATION_RUNTIME_SHA is the accepted application runtime contained by that bundle.
PRENEURA_SOURCE_SHA=change-me-with-certified-40-char-deployment-source-sha
PRENEURA_APPLICATION_RUNTIME_SHA=change-me-with-certified-40-char-application-runtime-sha

# PostgreSQL. Use a managed/HA database for serious production deployments.
DATABASE_URL=postgresql://preneura:change-me@db.example.internal:5432/preneura
DATABASE_WAIT_TIMEOUT_MS=60000
MIGRATION_ACTOR=selfhosted-release
MIGRATION_ADOPT_EXISTING=false

# Edge/runtime limits.
TRUST_PROXY_HOPS=1
API_BODY_LIMIT_BYTES=8388608

# Authentication and contact cryptography. Generate independent random values.
AUTH_IDENTIFIER_HMAC_KEY=change-me-with-32-plus-random-characters
AUTH_OTP_PEPPER=change-me-with-32-plus-random-characters
COOKIE_SIGNING_SECRET=change-me-with-32-plus-random-characters
CONTACT_HMAC_KEY=change-me-with-32-plus-random-characters
CONTACT_VERIFICATION_PEPPER=change-me-with-32-plus-random-characters
CONTACT_ENCRYPTION_KEY_BASE64=change-me-with-canonical-base64-32-byte-key

# OIDC / Google through Keycloak.
OIDC_ISSUER=https://id.example.com/realms/preneura
OIDC_CLIENT_ID=preneura-web
OIDC_CLIENT_SECRET=change-me-with-real-client-secret

# S3-compatible private object storage.
OBJECT_STORAGE_BUCKET=preneura-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_ACCESS_KEY_ID=change-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=change-me
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Malware scanner and finance/settlement ingress.
DOCUMENT_SCANNER_URL=https://scanner.example.internal/scan
DOCUMENT_SCANNER_TOKEN=change-me-with-scanner-token
DOCUMENT_SCANNER_TIMEOUT_MS=20000
FINANCE_PROVIDER_INGRESS_TOKEN=change-me-with-32-plus-random-characters
SETTLEMENT_PROVIDER_INGRESS_TOKEN=change-me-with-32-plus-random-characters

# Worker / notification gateway.
WORKER_ID=production-worker-1
INVENTORY_LOCK_EXPIRY_SCAN_MS=1000
INVENTORY_LOCK_EXPIRY_BATCH_SIZE=500
OUTBOX_POLL_MS=300
NOTIFICATION_POLL_MS=1000
SLA_SCAN_MS=30000
INSTALLMENT_REMINDER_SCAN_MS=30000
COMMISSION_DUE_SCAN_MS=30000
NOTIFICATION_GATEWAY_TOKEN=change-me-with-32-plus-random-characters

# Meta WhatsApp Cloud API.
META_GRAPH_API_VERSION=v23.0
META_WHATSAPP_PHONE_NUMBER_ID=change-me
META_WHATSAPP_ACCESS_TOKEN=change-me-with-real-meta-token
WHATSAPP_TEMPLATE_BINDINGS_JSON={"auth.login.otp":{"name":"preneura_login_otp","language":"ar","bodyParameterPaths":["code"]},"auth.enrollment.verify":{"name":"preneura_account_verify","language":"ar","bodyParameterPaths":["code"]}}

# Optional SMS/email adapters.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=

# Optional external AI. Core sales remains functional without it.
AI_PROVIDER_URL=
AI_PROVIDER_TOKEN=
AI_PROVIDER_MODEL=
AI_PROVIDER_TIMEOUT_MS=8000

# OpenTelemetry. Production must point to a reachable private/authenticated collector.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.internal
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_INSECURE=false
# Keep this aligned with PRENEURA_SOURCE_SHA so telemetry and container provenance agree.
OTEL_SERVICE_VERSION=change-me-with-certified-40-char-deployment-source-sha
OTEL_TRACE_SAMPLE_RATIO=0.1
OTEL_EXPORTER_TIMEOUT_MS=10000
LOG_LEVEL=info