{
  "name": "@preneura/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "node scripts/validate-build-config.mjs && pnpm run build:deps && next build",
    "build:deps": "pnpm --filter @preneura/contracts build && pnpm --filter exceljs build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --test scripts/locale-money.test.mjs"
  },
  "dependencies": {
    "@preneura/contracts": "workspace:*",
    "exceljs": "workspace:*",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "7.0.2"
  }
}
