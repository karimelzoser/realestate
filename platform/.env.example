NODE_ENV=development
PORT=4100
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4100
DATABASE_URL=postgresql://preneura:preneura@localhost:5432/preneura
REDIS_URL=redis://localhost:6379

# HTTP edge security. In production, TRUST_PROXY_HOPS must match the actual trusted
# reverse-proxy chain. Do not use an unconditional trustProxy=true configuration.
# API_BODY_LIMIT_BYTES applies to parsed API bodies; file/document uploads go directly
# to object storage and are not routed through this limit.
TRUST_PROXY_HOPS=1
API_BODY_LIMIT_BYTES=8388608

# Release migration identity. Normal releases leave adoption disabled.
MIGRATION_ACTOR=local-release
MIGRATION_ADOPT_EXISTING=false

# Auth / security. Generate long random secrets; never commit real values.
AUTH_IDENTIFIER_HMAC_KEY=replace-with-at-least-32-random-characters
AUTH_OTP_PEPPER=replace-with-at-least-32-random-characters
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_REQUEST_WINDOW_SECONDS=600
AUTH_OTP_MAX_REQUESTS_PER_WINDOW=5
COOKIE_SIGNING_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=preneura_session
SESSION_TTL_SECONDS=43200

# Encrypted delivery contacts / account enrollment.
CONTACT_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-key
CONTACT_HMAC_KEY=replace-with-at-least-32-random-characters
CONTACT_VERIFICATION_PEPPER=replace-with-at-least-32-random-characters
CONTACT_VERIFICATION_TTL_SECONDS=600

# OIDC / Google through Keycloak
OIDC_ISSUER=http://localhost:8080/realms/preneura
OIDC_CLIENT_ID=preneura-web
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URI=http://localhost:4100/v1/auth/google/callback

# OTP delivery adapter. 'console' is development-only and hard-blocked in production.
OTP_CHANNEL=sms
OTP_PROVIDER=console
AUTH_OTP_GATEWAY_URL=http://localhost:4300/auth-otp
CONTACT_VERIFICATION_GATEWAY_URL=http://localhost:4300/contact-verification

# S3-compatible document storage.
OBJECT_STORAGE_BUCKET=preneura-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Document malware scanning. Trusted uploads fail closed when this scanner is absent.
DOCUMENT_SCANNER_URL=http://localhost:4400/scan
DOCUMENT_SCANNER_TOKEN=replace-with-scanner-service-token
DOCUMENT_SCANNER_TIMEOUT_MS=20000

# Finance provider ingress.
FINANCE_PROVIDER_INGRESS_TOKEN=replace-with-at-least-32-random-characters

# Settlement provider ingress. Approval/submission never marks money paid; only immutable
# provider evidence can settle/reverse buyer refunds and broker commissions.
SETTLEMENT_PROVIDER_INGRESS_TOKEN=replace-with-at-least-32-random-characters

# Dedicated worker identity and polling cadence.
WORKER_ID=local-worker-1
INVENTORY_LOCK_EXPIRY_SCAN_MS=1000
INVENTORY_LOCK_EXPIRY_BATCH_SIZE=500
OUTBOX_POLL_MS=300
NOTIFICATION_POLL_MS=1000
SLA_SCAN_MS=30000
INSTALLMENT_REMINDER_SCAN_MS=30000
COMMISSION_DUE_SCAN_MS=30000

# Private first-party notification gateway.
NOTIFICATION_GATEWAY_URL=http://localhost:4300/deliver
NOTIFICATION_GATEWAY_TOKEN=replace-with-at-least-32-random-characters

# Meta WhatsApp Cloud API. Keep provider credentials only on the gateway service.
META_GRAPH_API_VERSION=replace-with-approved-graph-api-version
META_WHATSAPP_PHONE_NUMBER_ID=replace-me
META_WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_TEMPLATE_BINDINGS_JSON={"auth.login.otp":{"name":"preneura_login_otp","language":"ar","bodyParameterPaths":["code"]},"auth.enrollment.verify":{"name":"preneura_account_verify","language":"ar","bodyParameterPaths":["code"]}}

# Optional gateway webhooks for non-WhatsApp channels.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=

# Optional AI provider. PRENEURA remains fully functional without it.
AI_PROVIDER_URL=
AI_PROVIDER_TOKEN=
AI_PROVIDER_MODEL=
AI_PROVIDER_TIMEOUT_MS=8000

# OpenTelemetry / structured observability. Production exporters must use a private,
# authenticated collector endpoint. Secrets belong in the deployment secrets manager.
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_VERSION=local
OTEL_TRACE_SAMPLE_RATIO=1
OTEL_EXPORTER_TIMEOUT_MS=10000
